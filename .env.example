# rankwayAI
APP_NAME="rankwayAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Local default: SQLite (zero deps). For MySQL via docker compose, switch below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketing_os
# DB_USERNAME=marketing
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Media library: public (local CDN URL via /storage) or s3 (S3-compatible)
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@rankwayai.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers (platform keys — Free clients get no AI; paid use free-tier first)
# Priority when AI_PROVIDER=auto: groq → cerebras → gemini → mistral → openrouter → openai
AI_PROVIDER=auto

# Groq free — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras free — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Gemini free — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral free tier — https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional paid fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# Optional: Zavu for live WhatsApp/Email channel sends (sandbox without key)
ZAVUDEV_API_KEY=
ZAVU_BASE_URL=https://api.zavu.dev

# RCS providers (enable + keys per carrier)
RCS_DEFAULT_PROVIDER=sandbox
RCS_JIO_ENABLED=false
RCS_JIO_BASE_URL=https://api.jio.com/rcs
RCS_JIO_CLIENT_ID=
RCS_JIO_CLIENT_SECRET=
RCS_JIO_AGENT_ID=
RCS_JIO_SEND_PATH=/v1/messages
RCS_JIO_AUTH=bearer

RCS_AIRTEL_ENABLED=false
RCS_AIRTEL_BASE_URL=
RCS_AIRTEL_CLIENT_ID=
RCS_AIRTEL_CLIENT_SECRET=
RCS_AIRTEL_AGENT_ID=

RCS_VI_ENABLED=false
RCS_VI_BASE_URL=
RCS_VI_CLIENT_ID=
RCS_VI_CLIENT_SECRET=
RCS_VI_AGENT_ID=

RCS_ZAVU_ENABLED=false

# Social OAuth (sandbox without these)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Google SEO (GSC OAuth + PageSpeed CWV)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PAGESPEED_API_KEY=
# Match Google Cloud Console → PageSpeed Insights API quotas
SEO_PAGESPEED_QUERIES_PER_DAY=25000
SEO_PAGESPEED_QUERIES_PER_MINUTE=240
SEO_PAGESPEED_QUOTA_SAFETY_PERCENT=90
SEO_PAGESPEED_COOLDOWN_MINUTES=30
SEO_PAGESPEED_MAX_RUNS_PER_WINDOW=2
SEO_GSC_SYNC_COOLDOWN_MINUTES=60

# Marketing calendar (AI posts) — dynamic from Google ICS + public holiday API
FESTIVAL_COUNTRY=IN
FESTIVAL_NAGER_ENABLED=true
FESTIVAL_ICS_ENABLED=true
# Comma-separated ICS URLs (default: Google "Holidays in India")
# FESTIVAL_ICS_URLS=https://calendar.google.com/calendar/ical/en.indian%23holiday%40group.v.calendar.google.com/public/basic.ics

# DataForSEO (keyword volume/KD + live SERP ranks) — https://dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
SEO_METRICS_PROVIDER=dataforseo
SEO_RANK_PROVIDER=auto
SEO_DEFAULT_LOCATION=India
SEO_DEFAULT_LANGUAGE=en
SEO_METRICS_CACHE_DAYS=7

# Rankway Website Score (public checker + SEO Rank tab)
RANKWAY_DOMAIN_CACHE_HOURS=24
RANKWAY_DEFAULT_COUNTRY=IN
RANKWAY_MIN_INDEX_PERCENTILE=50
RANKWAY_MIN_INDEX_FOR_RANK=50
RANKWAY_PROBE_ONLY_SCORE_CAP=72

# Browserless (JS render crawl) — https://www.browserless.io/
BROWSERLESS_TOKEN=
BROWSERLESS_URL=

# Askefy (blog pages / posts API) — APP_URL of the Askefy app (no /api suffix)
ASKEFY_BASE_URL=http://127.0.0.1:8001
ASKEFY_PUBLIC_URL=http://127.0.0.1:8001
# Must be a separate URL/port from APP_URL (not localhost:8000 while RankwayAI runs on :8000).

# Billing — Cashfree (India ₹ + Global $)
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01

# Legacy (unused for new checkouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_AGENCY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_GROWTH_YEARLY=
RAZORPAY_PLAN_AGENCY_YEARLY=

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_AGENCY_YEARLY=

# Public marketing SEO (rankwayAI landing)
SEO_MARKETING_TITLE="rankwayAI — SEO & Digital Marketing Platform"
SEO_MARKETING_DESCRIPTION="rankwayAI is a marketing OS for SEO audits, Google Search Console, PageSpeed fixes, social scheduling, WhatsApp, and CRM — built for businesses and agencies."
SEO_MARKETING_KEYWORDS="rankwayAI, SEO software India, Google Search Console tool, digital marketing platform, social media scheduler"
# SEO_MARKETING_OG_IMAGE=https://your-cdn/og-rankwayai.png

# Public domain for SEO canonical/sitemap (production)
SEO_PUBLIC_URL=https://rankwayai.com

# Public https URL for social image publish (local dev: ngrok / Cloudflare tunnel)
# SOCIAL_PUBLIC_URL=https://your-tunnel.example.com

# Local only: mark posts published without calling Meta (test draft → approve → publish flow)
# SOCIAL_SIMULATE_PUBLISH=true
SEO_MARKETING_TITLE="RankwayAI — SEO & Digital Marketing Platform"
SEO_MARKETING_DESCRIPTION="RankwayAI (rankwayai.com) is a marketing OS for SEO audits, Google Search Console, PageSpeed fixes, social scheduling, WhatsApp, and CRM."
SEO_MARKETING_OG_IMAGE=/img/rankwayai-logo.png
SEO_MARKETING_CONTACT_EMAIL=contact@rankwayai.com
SEO_MARKETING_CONTACT_PHONE="+91 9889995999"
